# Plantilla de variables de entorno de Aldebaran.
# Copiar a .env (que nunca se versiona) y completar. Las rutas relativas se toman desde la raíz del repo.
# En modo mock (MOCK_MODE=true) no hace falta ninguna otra variable.

# --- Obligatorias fuera del modo mock ---

# API key de Anthropic, para clasificar los comprobantes de pago con Claude.
ANTHROPIC_API_KEY=completar-con-tu-api-key

# Casilla de Gmail del sistema: desde ella se envían los emails y en ella se reciben las respuestas.
GMAIL_USER=facturacion@ejemplo.com

# Contraseña de aplicación de esa casilla de Gmail (no la contraseña de la cuenta).
GMAIL_APP_PASSWORD=completar-con-la-contrasena-de-aplicacion

# CUIT de la empresa emisora, el mismo del certificado de ARCA. En modo mock vale 20111111112 si no se define.
ARCA_CUIT=20111111112

# Certificado de ARCA homologación (no se versiona).
ARCA_CERT_PATH=certs/arca-homologacion.crt

# Clave privada del certificado de ARCA homologación (no se versiona).
ARCA_KEY_PATH=certs/arca-homologacion.key

# --- Opcionales ---

# Puerto del server. Por defecto 3000.
PORT=3000

# Base SQLite del modo real. Por defecto data/aldebaran.db. En modo mock se ignora.
DATABASE_PATH=data/aldebaran.db

# Dirección de la web, para armar los links de los emails (por ejemplo, la recuperación de contraseña).
APP_URL=http://localhost:5173

# Procesos automáticos (facturación, recordatorios y revisión de la casilla): solo corren con "true".
# En modo mock, si no se define, se toma como "true".
SCHEDULER_ENABLED=false

# Solo desarrollo: si se define, todos los emails se envían a esta casilla en lugar del destinatario real.
EMAIL_REDIRECT_TO=

# Con "true" simula ARCA, el LLM y el email, y usa su propia base data/aldebaran-mock.db.
MOCK_MODE=false
